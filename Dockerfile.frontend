# Dockerfile.frontend
# ====================
#
# Builds the Streamlit frontend image. Kept as a separate, lightweight
# image from the backend so the frontend can be deployed independently
# (e.g. on Streamlit Community Cloud) while the backend runs elsewhere
# (e.g. Render).

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8501

CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
